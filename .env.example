# URL de tu app en producción (sin barra al final)
TIENDA_URL=https://tu-app.railway.app

# Token secreto compartido entre el scraper y la app
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCRAPER_SECRET=cambia-esto-por-un-token-seguro

# Segundos de espera entre búsquedas (default: 8000ms = 8s)
# Aumentar si hay bloqueos de ML
DELAY_ENTRE_BUSQUEDAS_MS=8000
